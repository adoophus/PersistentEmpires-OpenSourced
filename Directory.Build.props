<Project>
  <!--
    Game install locations. Never commit TaleWorlds binaries; point these at your local installs.
    Override in Directory.Build.props.user (git-ignored; written by scripts\setup.ps1) or via -p:BannerlordClientPath=...
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

  <PropertyGroup>
    <BannerlordClientPath Condition="'$(BannerlordClientPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordClientPath>
    <BannerlordServerPath Condition="'$(BannerlordServerPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Dedicated Server</BannerlordServerPath>
    <BannerlordClientBin>$(BannerlordClientPath)\bin\Win64_Shipping_Client</BannerlordClientBin>
    <BannerlordServerBin>$(BannerlordServerPath)\bin\Win64_Shipping_Server</BannerlordServerBin>
    <BannerlordClientModules>$(BannerlordClientPath)\Modules</BannerlordClientModules>
    <BannerlordServerModules>$(BannerlordServerPath)\Modules</BannerlordServerModules>
  </PropertyGroup>
</Project>